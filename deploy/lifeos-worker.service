[Unit]
Description=Life OS Notification Worker
Documentation=https://life.o2lin1.com
After=network-online.target postgresql@16-main.service lifeos-api.service
Wants=network-online.target
Requires=postgresql@16-main.service

[Service]
Type=simple
User=lifeos
Group=lifeos
WorkingDirectory=/opt/lifeos
EnvironmentFile=/opt/lifeos/.env
Environment=NODE_ENV=production
ExecStart=/opt/lifeos/node_modules/.bin/tsx /opt/lifeos/src/worker/index.ts

Restart=always
RestartSec=5
MemoryMax=256M
MemoryHigh=200M
LimitCORE=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifeos-worker

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
