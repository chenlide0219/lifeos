# ── Life OS 环境变量模板 ──
# 复制为 .env 后填写；.env 绝不提交到仓库。

# 数据库（仅本机监听，不对公网开放）
DATABASE_URL=postgresql://lifeos:CHANGE_ME@127.0.0.1:5432/lifeos

# 服务监听（Nginx 反代，不直接对外）
HOST=127.0.0.1
PORT=8890

# 用户时区
TZ=Asia/Shanghai

# 会话签名与有效期
SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
SESSION_TTL_DAYS=30
# 生产走 HTTPS 时必须保持 1；本地 HTTP 调试可设 0
COOKIE_SECURE=1

# ── AI 能力（密钥仅保存在服务端，不得进入前端构建产物）──
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

# ── 微信通知（Clawbot 适配器）──
# 未配置时 Worker 不消费提醒任务，任务保持 pending 不会丢失
CLAWBOT_ENDPOINT=
CLAWBOT_TOKEN=

# ── 通知 Worker 调参 ──
WORKER_POLL_MS=20000
WORKER_BATCH=10
# 超过该分钟数仍未发出的提醒标记为“错过”，不补发
MISSED_AFTER_MINUTES=120

# ── 备份（PRD FR-08）──
# BACKUP_GPG_RECIPIENT=your@email.com
# BACKUP_RCLONE_REMOTE=remote:lifeos-backups
