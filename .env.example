# ── Life OS 环境变量模板 ──
# 复制为 .env 后填写；.env 绝不提交到仓库。

# 数据库（仅本机监听，不对公网开放）
DATABASE_URL=postgresql://lifeos:CHANGE_ME@127.0.0.1:5432/lifeos

# 服务监听（Nginx 反代，不直接对外）
HOST=127.0.0.1
PORT=8890

# 用户时区
TZ=Asia/Shanghai

# 会话签名与有效期
SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
SESSION_TTL_DAYS=30
# 生产走 HTTPS 时必须保持 1；本地 HTTP 调试可设 0
COOKIE_SECURE=1

# ── AI 能力（密钥仅保存在服务端，不得进入前端构建产物）──
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

# ── V1.1 微信创建与查询：Jev 意图路由（PRD 4.3）──
# 调用顺序按 AGENTS.md：官方优先，官方不可用时回退中转。
# 官方端点固定为 https://api.typesafe.ai/v1/systemone（不提供覆盖项）。
#
# 实测（2026-10-12）：
#   - 中国大陆出口调官方 → HTTP 451「Typesafe is not available in your region.」
#   - 美国 VPS 调官方     → HTTP 200；因此生产直连官方即可
#   - 中转站从中美两地均 200，本地开发会自动落到它
# 官方密钥来自根目录 jev_official_keys.txt（不要提交到仓库）。
JEV_OFFICIAL_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=30000
# 中转站（仅在官方不可用时使用）；baseurl 可含或不含 /v1/systemone
JEV_BASE_URL=
JEV_API_KEY=

# ── V1.1 微信创建与查询：行为参数（PRD 16.1，已确认）──
# 草稿有效期：自最后一次有效修改起算并续期
WECHAT_DRAFT_TTL_MINUTES=30
# 正文保留天数（终态审计与幂等凭据不随正文清理）
WECHAT_BODY_RETENTION_DAYS=7
# 单次查询回复条数上限与单条长度上限（先到者为准）
WECHAT_QUERY_MAX_ITEMS=8
WECHAT_QUERY_MAX_CHARS=600

# 入站处理：租约（崩溃后可回收）、重试上限与每轮批量
WECHAT_INBOX_LEASE_MINUTES=5
WECHAT_INBOX_MAX_ATTEMPTS=3
WECHAT_INBOX_BATCH=5
# 回复发送：租约、重试上限与每轮批量
WECHAT_OUTBOX_LEASE_MINUTES=5
WECHAT_OUTBOX_MAX_ATTEMPTS=3
WECHAT_OUTBOX_BATCH=3

# 业务输入开关：设为 0 时**不处理**微信创建/查询，
# 但主动提醒（notification_jobs）**不受影响**，仍按原调度发送。
# 用于出问题时先停业务输入、保留提醒能力（PRD 13 阶段 5）。
WECHAT_INBOUND_ENABLED=1

# 模型调用开关：设为 0 时跳过 Jev/DeepSeek 调用。
# 仅供离线验证使用；生产必须保持 1，否则自然语言创建与查询不可用
# （确定性命令如 /today、确认短码仍然可用）。
WECHAT_MODEL_CALLS=1

# ── 微信通知：iLink 发送通道 ──
# 协议复用自既有实现（MultiHarnessWechatNotifier 的 wechat_bridge.py 与
# codex-wechat-handoff 的 codex-wechat-ilink.ts），但凭据必须独立配置，
# 不复用也不复制原项目的 account.json / context_tokens.json。
#
# ⚠️ 多用户改造后（2026-10-13）：**提醒与回复的发送凭据不再来自环境变量**。
# 每个账号各自在「设置 → 微信提醒」扫码绑定，凭据加密存在数据库的
# `wechat_accounts` 表里（按 user_id 一行），接收游标与 8/10 发送窗口也随之各账号独立。
#
# 为什么删掉环境变量通道：一个全局凭据无法归属到任何账号。若保留它作为兜底，
# 就会出现"B 绑定了微信、于是 A 的提醒被发到 B 的微信上"这种跨账号泄露。
#
# 因此 ILINK_TOKEN / ILINK_TO_USER_ID / ILINK_CONTEXT_TOKEN 这**三个变量已不再生效**，
# 填写它们不会有任何效果（保留在下方的注释里以免运维误以为还需要配置）。
# 下面两个仍然有效：作为扫码绑定时未返回服务地址/超时时的默认值。
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_TIMEOUT_MS=15000

# 以下三个已废弃，仅为历史对照保留；不要填写（填了也不会被读取）
# ILINK_TOKEN=
# ILINK_TO_USER_ID=
# ILINK_CONTEXT_TOKEN=

# ── 通知 Worker 调参 ──
WORKER_POLL_MS=20000
WORKER_BATCH=10
WORKER_LEASE_MINUTES=5
# 超过该分钟数仍未发出的提醒标记为"错过"，不补发
MISSED_AFTER_MINUTES=120

# ── 加密备份（PRD FR-08）──
# 必填：加密公钥（指纹或邮箱）。备份强制加密，未配置时备份脚本会失败退出。
# 由 deploy/setup-backup-keys.sh 生成并打印。
BACKUP_GPG_RECIPIENT=
# 可选：异机目标，形如 user@host:/var/backups/lifeos；未设置则跳过异机上传
BACKUP_OFFSITE=
BACKUP_SSH_KEY=/root/.ssh/lifeos_backup_ed25519
# BACKUP_OFFSITE_PORT=22
DAILY_KEEP=7
WEEKLY_KEEP=4

# ── 汇率快照（PRD FR-06）──
# 数据源由你自己决定（PRD §11.5 把"实际汇率数据源"列为部署阶段填写的配置项）。
# 未配置时：人民币付款照常记录；外币付款不折算，或用手动汇率并标注「估算」。
# 配置示例（URL 模板，{from}/{to}/{date} 会被替换）：
#   FX_PROVIDER_URL=https://api.example.com/rate?from={from}&to={to}&date={date}
#   FX_PROVIDER_NAME=example
# 若响应是 {rate: 7.12} 这类结构，无需配置下面这项（会自动识别常见字段名）；
# 结构特殊时用点路径指定取值位置：
#   FX_JSON_PATH=data.rates.CNY
# FX_TIMEOUT_MS=8000

# ── 测试（仅测试环境使用，库名必须以 _test 结尾）──
# TEST_DATABASE_URL=postgresql://lifeos:CHANGE_ME@127.0.0.1:5432/lifeos_test
